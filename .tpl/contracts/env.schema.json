{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "PORT": {
      "type": "string",
      "default": "43686",
      "pattern": "^[0-9]{1,5}$",
      "x-secret": false,
      "x-exposure": "server",
      "description": "本地 HTTP 监听端口"
    },
    "BIND_HOST": {
      "type": "string",
      "default": "127.0.0.1",
      "x-secret": false,
      "x-exposure": "server",
      "description": "本地 HTTP 监听地址"
    }
  },
  "required": []
}
